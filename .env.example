# Copy to .env and fill in the blanks:  cp .env.example .env
#
# Values marked (docker) are overridden by docker-compose.yml's environment:
# block when running under Docker. They only matter if you run the Python scripts directly on your host.

# --- Ollama ---
# (docker) compose points this at the ollama container automatically.
OLLAMA_HOST=http://127.0.0.1:11434

# Embeddings always run on the LOCAL/container Ollama (small + fast).
EMBED_MODEL=qwen3-embedding:0.6b

# Inference (orchestrator.py chat) goes to Ollama Cloud when this key is set,
# and falls back to the local Ollama when it's blank. Get one at ollama.com.
OLLAMA_API_KEY=

# Here's how to list what's currently available:
#   curl -s -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
INFERENCE_MODEL=gemma4:31b

# --- Qdrant ---
# (docker) compose sets QDRANT_HOST=qdrant.
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=confluent_support

# --- Scraping ---
# SUPPORT_COOKIE is an expirable session cookie copied from your logged-in browser.
# When it expiers re-copy it. Only needed to re-scrape; not needed to run the MCP server. See more in README.md
SUPPORT_BASE_URL=https://support.confluent.io
SUPPORT_COOKIE=
SUPPORT_CATEGORY_IDS=360004404872,360005831891,360005822052 # Getting Started, Confluent Cloud, Confluent Platform categories in order
CHUNK_SIZE=300

# --- Retrieval tuning ---
TOP_K_RESULTS=5
RERANK_MIN_SCORE=0

# --- MCP server ---
# (docker) compose sets MCP_HOST=0.0.0.0 so the container is reachable.
MCP_HOST=127.0.0.1
MCP_PORT=8000

# (docker) compose sets this to the mounted model_cache volume.
FASTEMBED_CACHE_DIR=./model_cache

# --- Authentication (optional, off by default) ---
# When false, anyone who can reach the tunnel URL can use every tool.
# See README.md "Authentication".
MCP_AUTH_ENABLED=false

# Entra app registration: Azure portal > Microsoft Entra ID > App registrations > New registration. Register it SINGLE-TENANT.
# Redirect URI (type "Web") must be exactly: <PUBLIC_MCP_URL>/auth/callback
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Custom API scope name from the app registration's "Expose an API" section.
# Entra tokens do not carry OIDC scopes, so a custom one is required.
AZURE_API_SCOPE=access

# Only needed if the Entra app issues v1.0 tokens (issuer mismatch error in the server log). 
# Preferred fix is the app manifest: set "requestedAccessTokenVersion": 2
# Otherwise, AZURE_TOKEN_ISSUER=https://sts.windows.net/<tenant-id>/
AZURE_TOKEN_ISSUER=

# The public https:// URL clients actually reach
# e.g. https://mcp-server-tool.ngrok-free.dev
PUBLIC_MCP_URL=

# --- Who may use the tools. Two modes; pick ONE. ---
# MODE A (broad) anyone on these domains.
# Comma-separated, e.g. dev.co.th. Matched EXACTLY against the part after the last "@"
ALLOWED_EMAIL_DOMAINS=

# MODE B (strict) ONLY these exact addresses
# e.g.  ALLOWED_EMAILS=alice@dev.co.th,bob@dev.co.th
# Case-insensitive. Leave blank to use MODE A.
ALLOWED_EMAILS=

# Signs tokens issued to clients. Leave blank and one is generated at startup
# Generate once:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_JWT_SIGNING_KEY=

# --- Remote access ------------------------------------------------------
# ngrok starts with the stack; cloudflared is opt-in via --profile cloudflare.
# See README.md "Remote access".

# Option A ngrok (starts automatically with docker compose up -d)
# NGROK_DOMAIN is your reserved static domain, hostname only, no https://
# e.g. mcp-server-tool.ngrok-free.dev
# Free tier: 1 static domain, 20k requests/month, 1GB transfer/month.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Option B Cloudflare Tunnel (docker compose --profile cloudflare up -d)
# Needs a domain on Cloudflare. No request/bandwidth quota, and supports
# free auth via Cloudflare Access. Token comes from the Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=
